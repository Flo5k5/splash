#!/bin/sh
# Le Splash du checkout (lai/main-20261029 : 1.5.0, main amont, PR #530, #532 et #534, control vector par requête),
# annoncé à oMLX sous la version de sa base : le lanceur d'un checkout répond « Splash (source checkout) », qu'oMLX
# refuse (engine/splash.py inspect_splash_binary). Tout le reste passe au lanceur du checkout tel quel.
set -eu
case " $* " in
  *" --version "*) echo "Splash 1.5.0"; exit 0 ;;
esac
root=$(CDPATH= cd -P -- "$(dirname -- "$0")" && pwd -P)
exec "$root/splash" "$@"
